{
    "type": "origins:multiple",

    "toggle": {
        "type": "origins:toggle",
        "active_by_default": true,
        "key": {
            "key": "key.origins.secondary_active"
        }
    },

    "climbing": {
        "type": "origins:climbing",
        "hold_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:or",
                    "conditions": [
                        {
                            "type": "origins:block_collision",
                            "offset_x": 0.01,
                            "offset_z": 0.01,
                            "offset_y": 0.0
                        },
                        {
                            "type": "origins:block_collision",
                            "offset_x": -0.01,
                            "offset_z": -0.01,
                            "offset_y": 0.0
                        }
                    ]
                },
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:or",
                    "conditions": [
                        {
                            "type": "origins:block_collision",
                            "block_condition": {
                                "type": "origins:in_tag",
                                "tag": "guaxi-origin:guaxi_cant_climb",
                                "inverted": true
                            },
                            "offset_x": 0.01,
                            "offset_z": 0.01
                        },
                        {
                            "type": "origins:block_collision",
                            "block_condition": {
                                "type": "origins:in_tag",
                                "tag": "guaxi-origin:guaxi_cant_climb",
                                "inverted": true
                            },
                            "offset_x": -0.01,
                            "offset_z": -0.01
                        }
                    ]
                },
                {
                    "type": "origins:collided_horizontally"
                },
                {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                }
            ]
        }
    }
}